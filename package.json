{
  "name": "@dsh-external/dsh-vision-toolkit",
  "version": "0.1.3",
  "description": "DeepSeek Harness-native integration for agent-vision-toolkit: image Q&A, OCR, grounding, UI restoration, pixel diff, Artifacts, and Web UI.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "agent-vision-toolkit",
    "agent-skills",
    "text-only-llm",
    "vision-language-model",
    "vision-tools",
    "computer-vision",
    "ocr",
    "ui-restoration",
    "screenshot-testing",
    "gui-automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-external/dsh-vision-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-external/dsh-vision-toolkit/issues"
  },
  "homepage": "https://agent-vision.anionex.me",
  "funding": "https://ifdian.net/a/anionex",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "examples",
    "docs",
    "assets",
    "runtime",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/upstream-manifest.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "prepack": "npm run build",
    "test": "vitest run tests",
    "verify:portable": "node scripts/upstream-manifest.mjs && node scripts/verify-portable.mjs",
    "example:ui-restoration": "node scripts/run-ui-restoration-example.mjs --check",
    "example:ui-restoration:write": "node scripts/run-ui-restoration-example.mjs --write",
    "upstream:manifest": "node scripts/upstream-manifest.mjs --write",
    "upstream:sync": "node scripts/sync-upstream.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "visionToolkit": {
      "upstreamRepository": "https://github.com/Anionex/agent-vision-toolkit",
      "upstreamVersion": "v0.1.0+snapshot.c27d1a3",
      "upstreamCommit": "c27d1a300962b553c0884993c575cd3e819465ce"
    }
  },
  "dependencies": {
    "saxes": "6.0.0",
    "schemastery": "npm:@deepseek-ai/schemastery@^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-tool": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-tools": "*",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
